# Producción (Vercel). Estos valores se hornean en el build.
# API vacía → usa el rewrite de vercel.json (/api → Render). Evita CORS.
VITE_API_URL=
# Socket.io conecta directo al backend de Render (los WebSocket no pasan por el rewrite)
VITE_SOCKET_URL=https://jarvisia.onrender.com
VITE_ENABLE_SPOTIFY=false

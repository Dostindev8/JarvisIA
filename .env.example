# ─── BACKEND (Railway/Render) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_HAIKU_MODEL=claude-3-5-haiku-20241022
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
MONGODB_URI=mongodb+srv://...
REDIS_URL=
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=change-me-in-production-min-32-chars
# WhatsApp Cloud API (Meta). Sin estas variables opera en modo simulado (log).
# Fallback dev: si Atlas no responde, se usa MongoDB en memoria con este usuario demo
DEMO_USER_EMAIL=admin@jarvisia.do
DEMO_USER_PASSWORD=JarvisIA2026!

# WhatsApp Cloud API (Meta) — deja API_TOKEN vacío para usar modo mock en desarrollo
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_CC=1
# Versión estable actual: v25.0 (feb 2026); v23/v24 siguen válidas. Fija una y súbela con pruebas.
WHATSAPP_GRAPH_VERSION=v23.0
# Webhook entrante: token que tú inventas y pones igual en el panel de Meta
WHATSAPP_VERIFY_TOKEN=
# App Secret de tu app de Meta → valida la firma de cada evento (obligatorio en producción)
WHATSAPP_APP_SECRET=
ENABLE_SPOTIFY=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
PORT=5000
DISABLE_CRON=false

# ─── FRONTEND (Vercel) ──────────────────────────────────────────────────────
VITE_API_URL=https://jarvis-api.up.railway.app
VITE_SOCKET_URL=https://jarvis-api.up.railway.app
VITE_ENABLE_SPOTIFY=false
